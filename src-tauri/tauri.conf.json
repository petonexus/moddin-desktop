{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moddin Desktop",
  "version": "0.1.0",
  "identifier": "dev.petonexus.moddin-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moddin Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Marco Antonio da Silva Junior",
    "category": "Utility",
    "shortDescription": "Moddin Desktop — manage game mods the safe way",
    "longDescription": "Moddin Desktop installs, previews, and rolls back game mods (VR mods, performance mods, overlays) for Steam, Epic, and GOG games on Windows. Every change is previewed, backed up, and reversible.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["en-US"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
