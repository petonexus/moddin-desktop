# Bundled MCP runtime (docs/AI-ASSISTANT.md): generated by
# moddin-runtime/bundle-runtime.ps1 before `npm run tauri build`. The
# scripts in that folder are source and stay tracked — only the
# generated bundle below is ignored.
moddin-runtime/node.exe
moddin-runtime/node.zip
moddin-runtime/tmp/
moddin-runtime/node_modules/
moddin-runtime/moddin-agent/
moddin-runtime/moddin-mcp.mjs
moddin-runtime/BUNDLE_OK
moddin-runtime/stderr.txt
moddin-runtime/*.tmp

# Generated and wrong-platform weight (roadmap O-11). None of it is read
# at runtime or by the build — see the notes per entry.

# Stale copy of the community catalog, generated by
# moddin-community-capabilities/scripts/regenerate_catalog.py from the
# capability YAMLs. The app downloads its own signed copy into
# %LOCALAPPDATA%/Moddin at runtime; nothing in this repo opens this file.
/catalog.json

# Release pack whose entire contents are already tracked, byte for
# byte, under tools/elden-ring-ervr-ofxr-baseline/. Ship the directory.
/EldenRing-ERVR-OFXR-Baseline-Moddin.zip

# macOS / iOS icons. Moddin is Windows-only (docs/SCOPE.md) and
# tauri.conf.json lists only icons/icon.ico under bundle.icon.
/src-tauri/icons/icon.icns
/src-tauri/icons/ios/

# tauri-build regenerates these on every build. The only reference is
# the "$schema" editor hint in src-tauri/capabilities/default.json,
# which resolves again the moment cargo runs.
/src-tauri/gen/schemas/
