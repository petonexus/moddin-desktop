{
  "name": "moddin-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Moddin Desktop — Windows-first PC game mod and tooling manager (Tauri 2 + Vue 3).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/petonexus/moddin-desktop.git"
  },
  "homepage": "https://github.com/petonexus/moddin-desktop",
  "bugs": {
    "url": "https://github.com/petonexus/moddin-desktop/issues"
  },
  "scripts": {
    "dev": "vite --port 1420",
    "typecheck": "vue-tsc --noEmit",
