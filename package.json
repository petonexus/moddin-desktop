{
  "name": "moddin-desktop",
  "private": true,
  "version": "0.1.0-beta.6",
  "description": "Moddin Desktop — Windows-first PC game mod and tooling manager (Tauri 2 + Vue 3).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/petonexus/moddin-desktop.git"
  },
  "homepage": "https://github.com/petonexus/moddin-desktop",
  "bugs": {
    "url": "https://github.com/petonexus/moddin-desktop/issues"
  },
  "scripts": {
    "dev": "vite --port 1420",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "check:catalog": "node scripts/validate-catalog.mjs",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "check:capability-kinds": "node scripts/check-capability-kind-parity.mjs",
    "check:bundle-features": "node scripts/check-bundle-features.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bundle:mcp": "esbuild moddin-agent/src/mcp-server.mjs --bundle --platform=node --target=node20 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=moddin-runtime/moddin-mcp.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.10",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.5.1",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.2",
    "vue-tsc": "^3.0.0"
  }
}
